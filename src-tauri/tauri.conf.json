{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CliFleet",
  "version": "0.6.1",
  "identifier": "org.clifleet.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CliFleet",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "CliFleet",
    "category": "DeveloperTool",
    "shortDescription": "CliFleet — 基于文件夹的 CLI 终端工作台",
    "longDescription": "CliFleet：极简的基于文件夹的 CLI 终端工作台。选一个文件夹、开多个终端标签、跑 claude / codex 等 CLI。完全本地、免安装、无内置 Key；模型与端点由 claude、codex 等 CLI 自己管理配置。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
